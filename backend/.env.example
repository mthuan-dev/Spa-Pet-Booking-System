#cau hinh email cung vo zalo lay ròi ghi vo file .env, đây chỉ là mẫu thôi, muốn thì ib tao(thuận)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
# VNPay sandbox
# sau khi clone về thì tạo file backend/.env rồi copy 4 dòng này, rồi vào zalo lấy mã tmncode và hashsecrect
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay/return
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_SERVER_IP=127.0.0.1

# Temporary booking holds. Start Redis before enabling this feature.
BOOKING_REDIS_HOLDS_ENABLED=false
BOOKING_REDIS_URL=redis://localhost:6379
